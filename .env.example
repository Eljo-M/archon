ARCHON_POSTGRES_DSN=postgresql://archon:archon_dev@localhost:5432/archon
ARCHON_REDIS_URL=redis://localhost:6379/0
ARCHON_BIND=127.0.0.1:50051
ARCHON_METRICS_PORT=9100
ARCHON_MODEL_URL=http://localhost:8000/v1
ARCHON_MODEL_NAME=replace-with-your-served-model
ARCHON_MODEL_API_KEY=
ARCHON_API_TOKEN=replace-with-a-local-development-token
ARCHON_SANDBOX_IMAGE=archon-sandbox:dev
ARCHON_ALLOWED_REPO_HOSTS=github.com
# Optional TLS; all three fields must be configured together for mutual TLS.
ARCHON_TLS_CERT=
ARCHON_TLS_KEY=
ARCHON_TLS_CA=
